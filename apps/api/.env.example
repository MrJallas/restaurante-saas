# Local-dev defaults for `apps/api`. Copy to `.env` (gitignored) and tweak.
#
# Convention: the root `.env` at the repo root is the single source of truth
# for compose; this file only exists so devs running `apps/api` standalone
# (without docker-compose) get the same defaults as the compose file injects.

# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/restaurant_saas
REDIS_URL=redis://localhost:6380

# === Mongo (chat history / LGPD) ===
# Note: the MongoService accepts MONGODB_URI and (legacy) MONGO_URL — pick one.
# docker-compose injects MONGODB_URI; keep them in sync if you set both.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=restaurant_chat

# === Auth / crypto ===
JWT_SECRET=change-me-in-production
ENCRYPTION_MASTER_KEY=change-me-in-production-32-chars
QR_HMAC_SECRET=change-me-in-prod
STAFF_API_KEY=dev-staff-api-key-change-in-prod

# === AI service ===
AI_SERVICE_URL=http://localhost:8000
# Shared secret enviado como X-AI-Service-Key; o ai-service FAIL-CLOSE em prod
# se ausente. Mesmo valor do compose / root .env.
AI_SERVICE_API_KEY=dev-ai-service-key-change-in-prod

# === CORS ===
# MUST include both 3003 (web-customer) and 3002 (web-staff). The default in
# `main.ts` already lists both, but real `.env` files override the default —
# omitting :3002 silently breaks the staff app's preflight.
CORS_ORIGINS=http://localhost:3003,http://localhost:3002

# === Server ===
PORT=3001
