# === Globais ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/restaurant_saas
REDIS_URL=redis://localhost:6380
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=restaurant_chat
MONGODB_SECURITY_DB=restaurant_security
JWT_SECRET=change-me-in-production
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=35000
# Shared secret entre apps/api (envia X-AI-Service-Key) e o ai-service (valida
# e FAIL-CLOSE em prod se ausente). Compose injeta nos dois — mantenha igual.
AI_SERVICE_API_KEY=dev-ai-service-key-change-in-prod
ENCRYPTION_MASTER_KEY=change-me-in-production-32-chars
# Gere com: openssl rand -hex 32 (obrigatório no Docker Compose; sem default).
SESSION_TOKEN_SECRET=
# Opcional em dev. Production/staging/preview exigem token staff mesmo que a
# variável seja omitida ou false; `true` permite testar esse gate localmente.
STAFF_SESSION_REQUIRED=false

# /customer/welcome (IP real + sessão de mesa). /customer/identify permanece
# separado em 5 tentativas/IP por 15 min.
CUSTOMER_WELCOME_RATE_MAX=30
CUSTOMER_WELCOME_RATE_WINDOW_SECONDS=900
CUSTOMER_WELCOME_RATE_LOCK_SECONDS=900

# === Microsservico de IA ===
LLM_PROVIDER=openai
# Docker Desktop + LM Studio neste Mac: use host.docker.internal. Se o servidor
# estiver em outra máquina da LAN, use o IP dela (ex.: http://192.168.0.15:1234/v1).
# Ao executar o ai-service fora do Docker, localhost continua válido.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=sk-xxx
LLM_MODEL_MAIN=gpt-4o
LLM_MODEL_CLASSIFIER=gpt-4o-mini
# LM Studio/Gemma: `none`; API oficial/modelos sem suporte: deixe vazio.
LLM_REASONING_EFFORT=
LLM_COMPACT_PROMPT=false
LLM_COMPACT_TOOL_SCHEMAS=false

# === PSP (Payment Service Provider) ===
PSP_WEBHOOK_SECRET=change-me

# === Storage (S3/R2) ===
S3_BUCKET=restaurant-saas
S3_REGION=auto
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# === CORS ===
CORS_ORIGINS=http://localhost:3003,http://localhost:3002

# === TVs de cozinha/bar (web-staff) ===
# PIN que destrava as telas anônimas de TV (KDS / status / call-waiter) via o
# proxy server-side e o middleware do web-staff. FAIL-CLOSE: em prod/staging
# (NODE_ENV/VERCEL_ENV = production|staging) a AUSÊNCIA deste PIN BLOQUEIA as
# rotas de TV — sem ele o proxy injetaria a x-staff-key real e liberaria a
# cozinha anonimamente. Em dev local (sem esta var) o gate vira no-op com
# warning. Defina um valor forte em prod. Deixe vazio/omita só em dev.
TV_ACCESS_PIN=
