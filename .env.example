# === Globais ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/restaurant_saas
REDIS_URL=redis://localhost:6380
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=restaurant_chat
MONGODB_SECURITY_DB=restaurant_security
JWT_SECRET=change-me-in-production
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=35000
# Shared secret entre apps/api (envia X-AI-Service-Key) e o ai-service (valida
# e FAIL-CLOSE em prod se ausente). Compose injeta nos dois — mantenha igual.
AI_SERVICE_API_KEY=dev-ai-service-key-change-in-prod
ENCRYPTION_MASTER_KEY=change-me-in-production-32-chars

# === Microsservico de IA ===
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=sk-xxx
LLM_MODEL_MAIN=gpt-4o
LLM_MODEL_CLASSIFIER=gpt-4o-mini

# === PSP (Payment Service Provider) ===
PSP_WEBHOOK_SECRET=change-me

# === Storage (S3/R2) ===
S3_BUCKET=restaurant-saas
S3_REGION=auto
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# === CORS ===
CORS_ORIGINS=http://localhost:3003,http://localhost:3002
