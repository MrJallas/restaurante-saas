# Copie para .env na raiz do repositório: cp .env.example .env
# O docker compose lê este arquivo. Os valores abaixo são os defaults do docker-compose.yml,
# com duas exceções: os dois segredos da seção "Obrigatórios", que não têm default, e
# HOME_CONTINUATION_ENABLED (ver o comentário da variável).

# === Obrigatórios (o compose não sobe sem eles) ===
# Gere cada um com: openssl rand -hex 32
SESSION_TOKEN_SECRET=
STAFF_API_KEY=

# === Rede ===
# IP da máquina na rede local, para abrir o app no celular (CORS, redirect do QR e
# allowedDevOrigins do Next). Usando só o computador, deixe localhost.
PUBLIC_HOST=localhost
# Em http:// pela rede local o navegador do celular bloqueia a geolocalização real;
# true deixa o app do cliente usar uma localização sintética (só desenvolvimento).
NEXT_PUBLIC_ALLOW_INSECURE_LAN_GEOLOCATION=true

# === Serviço de IA (assistente do cliente) ===
# Qualquer servidor compatível com a API da OpenAI (LM Studio, Ollama, a própria
# OpenAI). Com o stack no Docker, host.docker.internal é o computador hospedeiro.
# Sem um LLM acessível o sistema funciona; só o assistente de conversa degrada
# (ver "Limitação da IA" no README).
LLM_PROVIDER=openai
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL_MAIN=qwen2.5-7b-instruct-mlx
LLM_MODEL_CLASSIFIER=qwen2.5-7b-instruct-mlx
# LM Studio/Gemma: none. API oficial da OpenAI: deixe vazio.
LLM_REASONING_EFFORT=none
LLM_REQUEST_TIMEOUT=90
# Encurtam prompt e schemas de ferramentas para caber no contexto de modelos locais.
LLM_COMPACT_PROMPT=true
LLM_COMPACT_TOOL_SCHEMAS=true
#
# Alternativa: API da OpenAI (troque o bloco acima por este)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=<sua-chave>
# LLM_MODEL_MAIN=gpt-4o-mini
# LLM_MODEL_CLASSIFIER=gpt-4o-mini
# LLM_REASONING_EFFORT=
# LLM_COMPACT_PROMPT=false
# LLM_COMPACT_TOOL_SCHEMAS=false
#
# Também suportados: LLM_PROVIDER=anthropic ou google, com LLM_API_KEY do provedor.

# Tempo que a API espera o serviço de IA; fica um pouco acima de LLM_REQUEST_TIMEOUT.
AI_SERVICE_TIMEOUT_MS=95000
# Segredo compartilhado entre apps/api e o serviço de IA (o compose injeta nos dois).
AI_SERVICE_API_KEY=dev-ai-service-key-change-in-prod
# false: a home do cliente mostra os dois botões canônicos ("Chamar garçom" e "Ver cardápio");
# true: troca os botões pelas sugestões do assistente. Aqui fica false (tela canônica, esperada
# pelos testes E2E); sem a variável, o compose usa true.
HOME_CONTINUATION_ENABLED=false

# === Proteções ===
# Limite do /customer/welcome (por IP real + sessão de mesa).
# O /customer/identify tem limite próprio: 5 tentativas por IP a cada 15 min.
CUSTOMER_WELCOME_RATE_MAX=30
CUSTOMER_WELCOME_RATE_WINDOW_SECONDS=900
CUSTOMER_WELCOME_RATE_LOCK_SECONDS=900
# PIN que destrava as telas de TV (KDS, status, chamados). Em produção/staging a
# ausência BLOQUEIA as rotas de TV; em desenvolvimento, vazio libera com aviso.
TV_ACCESS_PIN=

# === Só para rodar um serviço fora do Docker ===
# O compose ignora este bloco: cada container recebe os endereços internos da rede
# do compose, e as portas de Postgres, Redis, Mongo e do serviço de IA não são
# publicadas no computador (acesso de dev: docker exec). Estes valores servem a
# quem roda um serviço direto no host com bancos próprios nessas portas.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/restaurant_saas
REDIS_URL=redis://localhost:6380
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=restaurant_chat
MONGODB_SECURITY_DB=restaurant_security
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3003,http://localhost:3002
# Produção/staging exigem token de equipe mesmo com false; true testa esse gate localmente.
STAFF_SESSION_REQUIRED=false
